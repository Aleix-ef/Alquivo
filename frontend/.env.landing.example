# Public build configuration only. Never put secret keys here.
LANDING_SITE_URL=https://alquivo.com
# Turnstile "Site key", not "Secret key". Real key required for production.
LANDING_TURNSTILE_SITE_KEY=
LANDING_INDEXABLE=true
# Copy this file to .env.landing.local (ignored by Git).
# Configure TURNSTILE_SECRET_KEY, WAITLIST_ENABLED and WAITLIST_DB in Cloudflare.
