VITE_API_URL=http://127.0.0.1:8100/api/v1
# Leave empty locally. Example for the future verified public domain: https://alquivo.com
VITE_PUBLIC_SITE_URL=
# Never enable on staging/preview environments. Requires the production domain above.
VITE_SEO_INDEXABLE=false
# Match backend BETA_PROGRAM_ENABLED when building public HTML.
VITE_BETA_PROGRAM_ENABLED=true
