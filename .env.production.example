# Plantilla, no desplegar sin completar. Nunca versionar .env.production.
APP_NAME=Alquivo
APP_ENV=production
APP_DEBUG=false
APP_KEY=
PUBLIC_DOMAIN=alquivo.example
ACME_EMAIL=
APP_URL=https://alquivo.example
FRONTEND_URL=https://alquivo.example
FRONTEND_URLS=https://alquivo.example
SANCTUM_STATEFUL_DOMAINS=alquivo.example
# Solo IP/CIDR de tu proxy de confianza; no usar *.
TRUSTED_PROXIES=172.30.20.11
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=alquivo
DB_USERNAME=alquivo
DB_PASSWORD=
DATABASE_ADMIN_PASSWORD=
# Para PostgreSQL remoto usar verify-full y certificados del proveedor.
DB_SSLMODE=disable
# disable is only for the private Docker network on this single host.
# External PostgreSQL MUST use verify-full with its trusted CA.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Alquivo
SUPPORT_EMAIL=soporte@alquivo.com
BILLING_ENABLED=false
FISCALITY_ENABLED=false
ASSISTANT_VALIDATED=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
UPLOADS_SCAN_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER_MONTHLY=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=es_ES

# Activar tras configurar proveedor, contrato y documentación de privacidad.
ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini
OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=900
