#!/usr/bin/env bash
# Run interactively on the VPS. Never pass the password in arguments or stdin.
set -Eeuo pipefail
umask 077

[[ $EUID -eq 0 ]] || { echo 'Ejecuta este comando con sudo.' >&2; exit 1; }
[[ $# -eq 1 && "$1" =~ ^u[0-9]+(-sub[0-9]+)?$ ]] || {
  echo 'Uso: sudo alquivo-storagebox-credentials u123456' >&2
  exit 1
}

directory=/etc/alquivo
target="$directory/storagebox.credentials"
[[ -d "$directory" && ! -L "$directory" ]] || {
  echo 'Falta el directorio privado de configuración del servidor.' >&2
  exit 1
}
[[ $(stat -c %u -- "$directory") == 0 ]] || {
  echo 'El directorio de configuración debe pertenecer a root.' >&2
  exit 1
}
permissions=$(stat -c %a -- "$directory")
(( (8#$permissions & 0022) == 0 )) || {
  echo 'El directorio de configuración no puede ser escribible por otros usuarios.' >&2
  exit 1
}
[[ ! -e "$target" && ! -L "$target" ]] || {
  echo 'Ya existe un archivo de credenciales. No se ha sobrescrito.' >&2
  exit 1
}

temporary=''
cleanup() {
  unset password confirmation
  if [[ -n "$temporary" ]]; then rm -f -- "$temporary"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

printf 'Contraseña de la Storage Box (no se mostrará): ' > /dev/tty
IFS= read -r -s password < /dev/tty
printf '\nRepite la contraseña: ' > /dev/tty
IFS= read -r -s confirmation < /dev/tty
printf '\n' > /dev/tty
[[ -n "$password" && "$password" == "$confirmation" ]] || {
  echo 'Las contraseñas están vacías o no coinciden. No se ha guardado nada.' >&2
  exit 1
}
[[ "$password" != *$'\r'* ]] || {
  echo 'La contraseña contiene un carácter de retorno no válido.' >&2
  exit 1
}

temporary=$(mktemp "$directory/.storagebox-credentials.XXXXXX")
printf 'username=%s\npassword=%s\n' "$1" "$password" > "$temporary"
unset password confirmation
chmod 600 -- "$temporary"
# Same-filesystem hard link publishes atomically without replacing an existing file.
ln -- "$temporary" "$target"
echo 'Credenciales guardadas con permisos privados. Todavía no se ha ejecutado ninguna copia.'
