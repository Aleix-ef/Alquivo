[Unit]
Description=Alquivo controlled Docker ingress for web access
Wants=network-online.target
After=network-online.target ufw.service
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/alquivo/network.env
ExecStart=/usr/local/sbin/alquivo-docker-firewall
ExecReload=/usr/local/sbin/alquivo-docker-firewall

[Install]
WantedBy=multi-user.target
