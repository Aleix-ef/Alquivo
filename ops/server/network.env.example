# Host configuration, not Laravel's environment. Replace the documentation IP.
# Do not commit the actual tester address. No CIDR or comma-separated lists.
ALQUIVO_PUBLIC_INTERFACE=ens3
ALQUIVO_TEST_IPV4=192.0.2.1
ALQUIVO_PROXY_IPV4=172.30.20.11
# Fail closed by default. Change only after explicit owner authorization.
# public permits IPv4 TCP/443 to the fixed proxy, never internal services/IPv6.
ALQUIVO_WEB_ACCESS=restricted
