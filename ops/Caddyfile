{
    email {$ACME_EMAIL}
    admin off
}

{$PUBLIC_DOMAIN} {$LEGACY_APP_DOMAIN:app.alquivo.com} {
    # HTTP-01 allows certificate issuance while HTTPS stays IP-restricted.
    # Keep port 80 available for automatic renewals; it redirects other traffic.
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    # Keep old sessions and host-bound signed links working, without indexing
    # a second copy of the site. Do not redirect private/token-bearing URLs.
    @legacy host {$LEGACY_APP_DOMAIN:app.alquivo.com}
    header @legacy >X-Robots-Tag "noindex, nofollow"
    request_body {
        max_size 12MB
    }
    reverse_proxy web:80
    # No access logs: reset tokens and verification signatures must not be logged.
}
